# Local-only connection for the provided Docker Compose setup.
DATABASE_URL=postgresql://day6:day6_local_only@127.0.0.1:55433/day6_lab

# Choose ONE provider if you use an API; local embeddings do not need an API key.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
EMBEDDING_MODEL=
# Embedding: local Ollama (no API key). See docs/run_environment.md.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
# PDF path, only needed for: python starter/ingest.py --reindex
PDF_PATH=data/AI Engineering Guidebook.pdf

# Agent model (Gemini API). Optional: GEMINI_THINKING_LEVEL / GEMINI_THINKING_BUDGET, GEMINI_MIN_INTERVAL (s between calls).
GEMINI_MODEL=gemini-3.5-flash-lite
